{
	"name": "asset-lending-manager-e2e",
	"private": true,
	"description": "Functional E2E tests for the Asset Lending Manager WordPress plugin.",
	"scripts": {
		"pretest:e2e": "node tests/e2e/bin/ensure-wp-cli.js",
		"test:e2e": "playwright test",
		"test:e2e:bootstrap": "node tests/e2e/bin/ensure-wp-cli.js",
		"test:e2e:headed": "node tests/e2e/bin/run-playwright-debug.js --headed",
		"test:e2e:ui": "node tests/e2e/bin/run-playwright-debug.js --ui"
	},
	"devDependencies": {
		"@playwright/test": "^1.54.1"
	}
}
